[org.gnome.desktop.interface]
font-name='Noto Sans CJK SC 11'
document-font-name='Noto Sans CJK SC 11'
monospace-font-name='Noto Sans Mono CJK SC 12'
gtk-theme='Yaru'
icon-theme='Yaru'
enable-animations=false

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/warty-final-ubuntu.png'
picture-uri-dark='file:///usr/share/backgrounds/ubuntu-wallpaper-d.png'

[org.gnome.desktop.session]
idle-delay=0

[org.gnome.desktop.screensaver]
lock-enabled=false

[org.gnome.desktop.lockdown]
disable-lock-screen=true
disable-log-out=true

[org.gnome.shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']

[org.gnome.shell:ubuntu]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']
