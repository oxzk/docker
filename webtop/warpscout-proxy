#!/usr/bin/env bash
# Warpscout SOCKS5 代理管理脚本.
#
# 用法: warpscout-proxy <start|stop|status>
#
# 验证代理出口 (容器内或经端口映射后):
#   curl --socks5-hostname 127.0.0.1:40000 https://ifconfig.me
#   curl --socks5-hostname 127.0.0.1:40000 -s https://ipinfo.io
set -Eeuo pipefail

readonly STATE_DIR="${WARPSCOUT_STATE_DIR:-${HOME}/.local/state/warpscout}"
readonly ACCOUNT_FILE="${STATE_DIR}/account.json"
readonly PID_FILE="${STATE_DIR}/proxy.pid"
readonly LOG_FILE="${STATE_DIR}/proxy.log"
readonly HOST=127.0.0.1
readonly PORT=40000
readonly PROXY_URL="socks5h://${HOST}:${PORT}"

is_proxy_process() {
    local pid="$1" args
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
    args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
    [[ "$args" == *'warpscout socks'* ]]
}

# 输出正在运行的代理进程 PID; 未运行时返回非零.
running_pid() {
    local pid
    [[ -s "$PID_FILE" ]] || return 1
    pid="$(<"$PID_FILE")"
    is_proxy_process "$pid" || return 1
    printf '%s\n' "$pid"
}

wait_for_proxy() {
    local pid="$1" attempt
    for attempt in {1..30}; do
        is_proxy_process "$pid" || return 1
        if (echo >"/dev/tcp/${HOST}/${PORT}") >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

probe_exit_ip() {
    curl -fsS --max-time 20 --socks5-hostname "${HOST}:${PORT}" https://ipinfo.io/json
}

print_exit_ip() {
    local info
    if info="$(probe_exit_ip 2>/dev/null)"; then
        printf 'Exit IP: %s\n' "$info"
    else
        printf 'Warning: failed to query exit IP through proxy\n' >&2
    fi
}

start_proxy() {
    local endpoint pid
    mkdir -p "$STATE_DIR"
    chmod 0700 "$STATE_DIR"
    if pid="$(running_pid)"; then
        printf 'Warpscout proxy already running at %s (pid=%s)\n' "$PROXY_URL" "$pid"
        print_exit_ip
        return 0
    fi
    rm -f "$PID_FILE"
    [[ -s "$ACCOUNT_FILE" ]] || warpscout register -a "$ACCOUNT_FILE"
    chmod 0600 "$ACCOUNT_FILE"
    endpoint="$(warpscout scan -a "$ACCOUNT_FILE" -p awg -P -country "${WARPSCOUT_COUNTRY:-US}" -best)"
    [[ -n "$endpoint" ]] || { printf 'No Warpscout endpoint available\n' >&2; return 1; }
    nohup warpscout socks -a "$ACCOUNT_FILE" -p awg -e "$endpoint" -l "$HOST" -P "$PORT" \
        </dev/null >>"$LOG_FILE" 2>&1 &
    pid="$!"
    printf '%s\n' "$pid" > "$PID_FILE"
    if ! wait_for_proxy "$pid"; then
        if is_proxy_process "$pid"; then
            kill "$pid" 2>/dev/null || true
            printf 'Warpscout proxy timed out waiting for %s (endpoint=%s), see %s\n' \
                "$PROXY_URL" "$endpoint" "$LOG_FILE" >&2
        else
            printf 'Warpscout proxy exited during startup (endpoint=%s), see %s\n' \
                "$endpoint" "$LOG_FILE" >&2
        fi
        rm -f "$PID_FILE"
        return 1
    fi
    printf 'Warpscout proxy started at %s (pid=%s, endpoint=%s)\n' \
        "$PROXY_URL" "$pid" "$endpoint"
    print_exit_ip
}

stop_proxy() {
    local pid
    if pid="$(running_pid)"; then kill "$pid"; fi
    rm -f "$PID_FILE"
}

status_proxy() {
    local pid
    if pid="$(running_pid)"; then
        printf 'Warpscout proxy running at %s (pid=%s)\n' "$PROXY_URL" "$pid"
        printf 'Verify: curl --socks5-hostname %s:%s https://ifconfig.me\n' "$HOST" "$PORT"
        return 0
    fi
    printf 'Warpscout proxy is not running\n' >&2
    return 1
}

main() {
    case "${1:-}" in
        start) start_proxy ;;
        stop) stop_proxy ;;
        status) status_proxy ;;
        *) printf 'Usage: %s <start|stop|status>\n' "$0" >&2; return 2 ;;
    esac
}

main "$@"
